{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Josepavese/nido",
  "title": "Nido - VM Manager for AI Agents",
  "description": "Local QEMU VM manager with opt-in MCP event subscriptions for AI agents.",
  "version": "0.0.0-dev",
  "websiteUrl": "https://github.com/Josepavese/nido",
  "repository": {
    "url": "https://github.com/Josepavese/nido",
    "source": "github",
    "id": "1127791293"
  },
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/Josepavese/nido/main/resources/nido-icon.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "mcpb",
      "identifier": "https://github.com/Josepavese/nido/releases/download/v0.0.0-dev/nido.mcpb",
      "version": "0.0.0-dev",
      "transport": {
        "type": "stdio",
        "command": "nido",
        "args": [
          "mcp"
        ],
        "platform": {
          "windows": {
            "command": "nido.cmd",
            "args": [
              "mcp"
            ]
          }
        }
      },
      "fileSha256": "SHA256_PLACEHOLDER"
    },
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "nido-mcp",
      "version": "0.0.0-dev",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
